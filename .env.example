# Public, non-secret API origin. Leave unset until the backend contract is confirmed.
# Browser requests use cookies; backend must allow the exact frontend origin with credentials.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Server-only local UI preview: requires NODE_ENV=development and exact true.
# Always disabled in production. This does not enable real authentication.
# DASHBOARD_UI_PREVIEW=true
