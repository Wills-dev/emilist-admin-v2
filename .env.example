# Public, non-secret API origin. Leave unset until the backend contract is confirmed.
# Browser requests use cookies; backend must allow the exact frontend origin with credentials.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Server-only local UI preview: requires NODE_ENV=development and exact true.
# Always disabled in production. This does not enable real authentication.
# DASHBOARD_UI_PREVIEW=true

# Vercel projects: configure these separately in each project, never commit actual values.
# APP_DEPLOYMENT_MODE=production
# DEMO_VERCEL_PROJECT_ID=<demo-project-id>
# ADMIN_VERCEL_PROJECT_ID=<real-admin-project-id>
# EMILIST_VERCEL_TEAM_ID=<owning-team-id>
# EMILIST_VERCEL_TEAM_SLUG=<owning-team-slug>
# Vercel supplies signed OIDC identities. Do not manually set tokens or VERCEL_* variables.
# Demo project: APP_DEPLOYMENT_MODE=demo, build with npm run build:demo, no API origins.
# DEMO_ALLOWED_HOSTS=<approved-demo-hostname>
# ADMIN_ALLOWED_HOSTS=<real-production-hostname>
